<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>GitIssue</title>
    <style>
        body { font-family: system-ui, sans-serif; color: #172033; background: #f5f7fb; margin: 0; }
        main { max-width: 70rem; margin: auto; padding: 2rem 1rem; }
        h1, h2 { color: #172b4d; }
        a { color: #175cd3; }
        section { background: white; border: 1px solid #d6deea; border-radius: .5rem; padding: 1.25rem; margin: 1rem 0; }
        table { border-collapse: collapse; width: 100%; }
        th, td { padding: .7rem; border-bottom: 1px solid #d6deea; text-align: left; vertical-align: top; overflow-wrap: anywhere; }
        input, textarea, button { font: inherit; padding: .5rem; }
        input, textarea { box-sizing: border-box; max-width: 100%; }
        textarea { width: 100%; min-height: 5rem; }
        button { cursor: pointer; }
        label { display: block; font-weight: 600; margin-bottom: .4rem; }
        .error { color: #a21d1d; }
        .success { color: #16703b; }
        .pagination { display: flex; gap: 1rem; align-items: center; margin-top: 1rem; }
        .field { margin-bottom: 1.5rem; }
        .field input { width: 100%; }
        .field input:not([type="hidden"]), .field textarea { display: block; }
        .field button { display: block; margin-top: .4rem; }
    </style>
</head>
<body>
    <main>
        <Routes />
    </main>
</body>
</html>
